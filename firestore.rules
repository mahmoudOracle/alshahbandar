rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() &&
        (request.auth.token.platformAdmin == true ||
         exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)));
    }

    function normalizeRole(value) {
      if (!value) return null;
      if (value is string) return value;
      if (value is map) {
        if (value.role is string) return value.role;
        if (value.memberRole is string) return value.memberRole;
        if (value.roleName is string) return value.roleName;
      }
      return null;
    }

    function roleAllowed(role) {
      return role is string && ['owner', 'manager', 'staff', 'employee', 'company_owner'].hasAny([role.lower()]);
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function companyIsActive(companyId) {
      const doc = companyDoc(companyId);
      if (!doc.exists()) return false;
      const isActiveValue = doc.data.isActive;
      return isActiveValue == null || isActiveValue != false;
    }

    function isCompanyActive(companyId) {
      return companyIsActive(companyId);
    }

    function memberDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function legacyCompanyUserDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function rootUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasMemberRole(companyId) {
      if (!isSignedIn()) return false;
      const doc = memberDoc(companyId);
      if (!doc.exists()) return false;
      return roleAllowed(normalizeRole(doc.data.role));
    }

    function hasLegacyCompanyUserRole(companyId) {
      if (!isSignedIn()) return false;
      const doc = legacyCompanyUserDoc(companyId);
      if (!doc.exists()) return false;
      return roleAllowed(normalizeRole(doc.data.role));
    }

    function hasRootMembership(companyId) {
      if (!isSignedIn()) return false;
      const doc = rootUserDoc();
      if (!doc.exists()) return false;
      const memberships = doc.data.memberships;
      if (!(memberships is map)) return false;
      return roleAllowed(normalizeRole(memberships[companyId]));
    }

    function companyHasAccess(companyId) {
      return (
        isSignedIn() &&
        companyIsActive(companyId) &&
        (hasMemberRole(companyId) || hasLegacyCompanyUserRole(companyId) || hasRootMembership(companyId))
      );
    }

    function companyUserDoc(companyId) {
      return memberDoc(companyId);
    }

    function isCompanyOwner(companyId) {
      if (!isSignedIn()) return false;
      const doc = companyDoc(companyId);
      return doc.exists() && doc.data.ownerUid == request.auth.uid;
    }

    function roleFromMember(companyId) {
      const doc = memberDoc(companyId);
      return doc.exists() ? normalizeRole(doc.data.role) : null;
    }

    function roleFromLegacy(companyId) {
      const doc = legacyCompanyUserDoc(companyId);
      return doc.exists() ? normalizeRole(doc.data.role) : null;
    }

    function roleFromRoot(companyId) {
      const doc = rootUserDoc();
      if (!doc.exists()) return null;
      const memberships = doc.data.memberships;
      if (!(memberships is map)) return null;
      return normalizeRole(memberships[companyId]);
    }

    function roleFromAnySource(companyId) {
      const memberRole = roleFromMember(companyId);
      if (memberRole != null) return memberRole;
      const legacyRole = roleFromLegacy(companyId);
      if (legacyRole != null) return legacyRole;
      return roleFromRoot(companyId);
    }

    function hasCompanyRole(companyId, roles) {
      if (!isSignedIn()) return false;
      const role = roleFromAnySource(companyId);
      if (!role) return false;
      return roles.hasAny([role.lower()]);
    }

    function companyMemberOrAdmin(companyId) {
      return isPlatformAdmin() || companyHasAccess(companyId);
    }


    // Companies
    match /companies/{companyId} {
      // Allow platform admins to fully manage companies
      allow create: if isPlatformAdmin() || (
        isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid
      );
      allow delete: if isPlatformAdmin();

      function isCompanyProfileUpdate() {
        return (
          request.resource.data.status == resource.data.status &&
          request.resource.data.plan == resource.data.plan &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.emailLower == resource.data.emailLower
        );
      }

      allow update: if isPlatformAdmin() || (
        isSignedIn() && hasCompanyRole(companyId, ['owner', 'manager']) && isCompanyProfileUpdate() && isCompanyActive(companyId)
      );

      function isManagerRole(companyId) {
        return hasCompanyRole(companyId, ['owner', 'manager', 'company_owner']);
      }

      function isStaffRole(companyId) {
        return hasCompanyRole(companyId, ['employee', 'staff']);
      }

      // Read allowed for authenticated members or platform admins
      allow read: if companyMemberOrAdmin(companyId);

      // Company scoped subcollections
      match /customers/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create: if isSignedIn() && (isManagerRole(companyId) || isStaffRole(companyId)) && isCompanyActive(companyId);
        allow update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /products/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create: if isSignedIn() && (isManagerRole(companyId) || isStaffRole(companyId)) && isCompanyActive(companyId);
        allow update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /expenses/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create: if isSignedIn() && (isManagerRole(companyId) || isStaffRole(companyId)) && isCompanyActive(companyId);
        allow update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /payments/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create: if isSignedIn() && (isManagerRole(companyId) || isStaffRole(companyId)) && isCompanyActive(companyId);
        allow update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /returns/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create, update, delete: if false;
      }

      match /supplierPayments/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create, update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /settings/{docId} {
        allow read: if companyMemberOrAdmin(companyId);
        allow create, update: if isSignedIn() && (isManagerRole(companyId)) && isCompanyActive(companyId);
        allow delete: if false;
      }

      match /{document=**} {
        // Reads allowed for members only (platform admins do not read tenant data)
        allow read: if companyMemberOrAdmin(companyId);

        // Allow company members to write for free-mode deployments.
        allow create, update, delete: if isSignedIn() &&
          hasCompanyRole(companyId, ['owner', 'manager', 'staff', 'company_owner']) &&
          isCompanyActive(companyId);
      }

      // Invoices: prevent client-side edits/deletes when a document is posted or its period is locked
      match /invoices/{invoiceId} {
        allow read: if companyMemberOrAdmin(companyId);

        function companyLockedForDate(ts) {
          // company doc may include `lockedPeriods` array of YYYY-MM strings
          let locked = false;
          if (exists(/databases/$(database)/documents/companies/$(companyId))) {
            let cp = get(/databases/$(database)/documents/companies/$(companyId)).data;
            if (cp.lockedPeriods is list) {
              let monthKey = '';
              // ts could be timestamp or string; attempt to parse timestamp
              monthKey = ts is timestamp ? (ts.toDate().getUTCFullYear() + '-' + (ts.toDate().getUTCMonth() + 1).toString().padStart(2, '0')) : '';
              locked = cp.lockedPeriods.hasAny([monthKey]);
            }
          }
          return locked;
        }

        allow create: if isSignedIn() && ((isManagerRole(companyId) || isStaffRole(companyId)) && isCompanyActive(companyId));

        allow update: if isSignedIn() && (
          (isManagerRole(companyId) && isCompanyActive(companyId)) &&
          // Disallow updating if invoice already posted
          !(resource.data.posted == true || resource.data.isPosted == true || resource.data.isFinal == true) &&
          // Disallow if period locked
          !companyLockedForDate(request.resource.data.date)
        );

        allow delete: if false; // prevent client-side deletes for invoices
      }

      // Audit logs: read allowed for company members, writes only allowed via Cloud Functions (admin SDK)
      match /auditLogs/{logId} {
        allow read: if companyMemberOrAdmin(companyId);
        // Deny client-side writes to audit logs. Audit entries must be written by
        // trusted server-side code (Cloud Functions using Admin SDK) to ensure immutability.
        allow create, update, delete: if false;
      }

      // Protect ledger & inventory: only platform admins (server-side) may modify these.
      // Clients should use server-side callables or Cloud Functions to append ledger entries
      // and update inventory snapshots. These collections remain readable by company users.
      match /stockLedger/{entryId} {
        allow read: if companyMemberOrAdmin(companyId);
        // Strict validation for ledger entries to ensure audit integrity.
        function validLedgerEntry() {
          return (
            request.resource.data.productId is string &&
            request.resource.data.change is number && request.resource.data.change != 0 &&
            request.resource.data.qtyBefore is number &&
            request.resource.data.qtyAfter is number &&
            // Ensure arithmetic consistency: qtyAfter == qtyBefore + change
            request.resource.data.qtyAfter == request.resource.data.qtyBefore + request.resource.data.change &&
            (request.resource.data.unitCost is number || request.resource.data.unitCost == null) &&
            request.resource.data.sourceType in ['SALE', 'PURCHASE', 'ADJUSTMENT', 'RETURN', 'INVOICE_ADJUSTMENT'] &&
            request.resource.data.referenceId is string &&
            // timestamp must be provided and cannot be in the future
            request.resource.data.timestamp is timestamp && request.resource.data.timestamp <= request.time
          );
        }

        // Allow creation by company roles when entry is valid.
        allow create: if isSignedIn() &&
          hasCompanyRole(companyId, ['owner', 'manager', 'staff', 'company_owner']) &&
          validLedgerEntry();
        allow update, delete: if false;
      }

      match /inventory/{productId} {
        allow read: if companyMemberOrAdmin(companyId);

        // Inventory snapshots must be consistent with product stock. Only admin callers may write.
        function validInventorySnapshot() {
          return (
            request.resource.data.productId is string &&
            request.resource.data.quantity is number &&
            request.resource.data.lastUpdated is timestamp && request.resource.data.lastUpdated <= request.time
          );
        }

        allow create: if isSignedIn() &&
          hasCompanyRole(companyId, ['owner', 'manager', 'staff', 'company_owner']) &&
          validInventorySnapshot();
        allow update: if isSignedIn() &&
          hasCompanyRole(companyId, ['owner', 'manager', 'staff', 'company_owner']) &&
          validInventorySnapshot();
        allow delete: if isSignedIn() &&
          hasCompanyRole(companyId, ['owner', 'manager', 'staff', 'company_owner']);
      }
    }

    // Membership docs
    match /companies/{companyId}/members/{userId} {
      allow read: if companyMemberOrAdmin(companyId);
      allow create: if isSignedIn() && (
        request.auth.uid == userId && (
          // Allow initial owner creation when the company doc does not exist yet.
          (!exists(/databases/$(database)/documents/companies/$(companyId)) &&
            request.resource.data.role == 'owner') ||
          // Otherwise require active company + role constraints.
          (isCompanyActive(companyId) &&
            (request.resource.data.role != 'owner' || isCompanyOwner(companyId)))
        )
      );
      allow update: if isSignedIn() && isCompanyActive(companyId) && (
        // Managers can update members, OR users can update themselves IF they don't change their role
        hasCompanyRole(companyId, ['owner', 'manager', 'company_owner']) ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if false;
    }

    // Invitations: NOT readable/writable by regular clients. Only server-side (Cloud Functions with admin SDK)
    // should access invitation documents. Deny client-side access to invitations to force use of callables.
    match /companies/{companyId}/invitations/{inviteId} {
      allow read, write: if false;
    }

    match /invitations/{inviteId} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Platform audit logs (admin only, server-side writes)
    match /auditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
