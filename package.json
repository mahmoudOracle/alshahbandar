{
  "name": "alshabandar-trading-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:mojibake": "node scripts/check-mojibake.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --ext .ts,.tsx,.js,.jsx --ignore-pattern dist --ignore-pattern functions --ignore-pattern src/__tests__ --ignore-pattern '**/*.test.*' --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"@typescript-eslint/no-unused-vars:warn\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix --ignore-pattern dist --ignore-pattern functions --ignore-pattern src/__tests__ --ignore-pattern '**/*.test.*' --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"@typescript-eslint/no-unused-vars:warn\"",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:integration": "vitest --run src/__tests__/integration --environment=node",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "emu": "firebase emulators:start --only auth,firestore --import=./firestore.rules --export-on-exit=./firestore.rules.bak.2025-11-19",
    "dev:emu": "concurrently --kill-others-on-fail -c \"bgBlue.bold,bgGreen.bold\" -n \"EMULATORS,VITE\" \"npm run emu\" \"npm run dev\"",
    "dev:prod": "vite --mode production",
    "seed:emu": "ts-node scripts/seedEmulators.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "firebase": "^12.6.0",    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0"
  },
  "optionalDependencies": {
    "@sentry/browser": "^7.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.9.15",
    "chrome-launcher": "^1.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "jsdom": "^22.0.0",
    "lighthouse": "^13.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.7.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^1.7.1",
    "typescript": "^5.9.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}


